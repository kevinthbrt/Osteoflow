{
  "manifest_version": 3,
  "name": "MyOsteoFlow, synchro d’agenda pour Doctolib",
  "short_name": "MyOsteoFlow",
  "version": "1.2.0",
  "description": "Envoie les rendez-vous de votre agenda Doctolib Pro vers MyOsteoFlow, sur votre poste. Outil indépendant, non affilié à Doctolib.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Synchroniser avec MyOsteoFlow",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://pro.doctolib.fr/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pro.doctolib.fr/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-32.png"
      ],
      "matches": [
        "https://pro.doctolib.fr/*"
      ]
    }
  ]
}
