{
  "manifest_version": 3,
  "name": "Osteoflow : import Doctolib",
  "short_name": "Osteoflow Doctolib",
  "version": "1.0.0",
  "description": "Envoie les rendez-vous du jour de votre agenda Doctolib Pro vers Osteoflow, sur votre poste. Outil indépendant, non affilié à Doctolib.",
  "icons": {
    "16": "icons/icon-128.png",
    "48": "icons/icon-128.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Envoyer à Osteoflow",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://pro.doctolib.fr/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://pro.doctolib.fr/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
